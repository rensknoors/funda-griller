# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# Local data
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# Downloaded media (photos, brochures, Documents)
backend/data/

# Frontend
node_modules/
dist/
test-results/
playwright-report/

PROTOTYPE_out/
