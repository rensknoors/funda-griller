# Copy to backend/.env. Read by backend/app/settings.py.
FG_GEMINI_API_KEY=
# RVO EP-Online API key (energielabel register). Without it the energielabel Source is skipped.
FG_EP_ONLINE_API_KEY=
# OpenRouteService API key (free Standard plan, openrouteservice.org) for commute travel times by
# car and bike. Without it the commute Source is skipped. Only coordinates are sent; destination
# addresses are geocoded by PDOK's Locatieserver (no key) and cached locally.
FG_OPENROUTESERVICE_API_KEY=
# Confirm real model identifiers against Google's docs at setup time.
FG_VISION_MODEL=
FG_VERDICT_MODEL=
# Source time-to-lives in days (after which facts are Stale).
FG_SOURCE_TTL_DAYS__ENERGIELABEL=365
FG_SOURCE_TTL_DAYS__WOZ=365
FG_SOURCE_TTL_DAYS__FLOOD_SOIL=365
FG_SOURCE_TTL_DAYS__NOISE=365
FG_SOURCE_TTL_DAYS__COMPARABLES=14
FG_SOURCE_TTL_DAYS__COMMUTE=180
