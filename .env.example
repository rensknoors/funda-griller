# Copy to backend/.env. Read by backend/app/settings.py.
FG_GEMINI_API_KEY=
# Confirm real model identifiers against Google's docs at setup time.
FG_VISION_MODEL=
FG_VERDICT_MODEL=
# Source time-to-lives in days (after which facts are Stale).
FG_SOURCE_TTL_DAYS__ENERGIELABEL=365
FG_SOURCE_TTL_DAYS__WOZ=365
FG_SOURCE_TTL_DAYS__FLOOD_SOIL=365
FG_SOURCE_TTL_DAYS__NOISE=365
FG_SOURCE_TTL_DAYS__COMPARABLES=14
